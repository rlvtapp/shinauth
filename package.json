{
  "name": "@shinauth/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlvtapp/shinauth.git"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install --reset-hooks-path || echo \"skipping lefthook (not a git repo)\"",
    "build": "moon run :build",
    "dev": "moon run api-key:dev core:dev drizzle-adapter:dev electron:dev expo:dev i18n:dev kysely-adapter:dev memory-adapter:dev mongo-adapter:dev oauth-provider:dev passkey:dev prisma-adapter:dev redis-storage:dev scim:dev shinauth:dev sso:dev stripe:dev telemetry:dev test-utils:dev",
    "clean": "moon run :clean && rm -rf node_modules",
    "format": "biome format . --write",
    "format:md": "pnpm --filter docs format:md",
    "format:check": "pnpm --filter docs format:check",
    "lint": "biome check . --error-on-warnings",
    "lint:dependencies": "knip && knip --production",
    "lint:fix": "biome check . --fix --unsafe",
    "lint:spell": "git ls-files | cspell --file-list stdin --color",
    "lint:types": "moon run :lintTypes",
    "lint:packages": "moon run :lintPackage",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:release": "moon run :clean && moon run :build && changeset publish",
    "test": "moon run :test && pnpm --dir test test",
    "coverage": "moon run :coverage && pnpm --dir test coverage",
    "postcoverage": "pnpm coverage:collect && pnpm coverage:merge && pnpm coverage:report",
    "coverage:merge": "nyc merge coverage/raw coverage/merged/merged-coverage.json",
    "coverage:collect": "rm -rf coverage && mkdir -p coverage/raw && for f in $(find packages test -name coverage-final.json); do pkg=$(basename \"$(dirname \"$(dirname \"$f\")\")\"); cp \"$f\" \"./coverage/raw/$pkg-coverage-final.json\"; done",
    "coverage:report": "nyc --temp-dir=./coverage/raw report --reporter=lcov --reporter text-summary",
    "coverage:open": "open coverage/lcov-report/index.html",
    "e2e:smoke": "pnpm --recursive --filter \"./e2e/**\" --if-present run e2e:smoke",
    "e2e:integration": "pnpm --recursive --filter \"./e2e/**\" --if-present run e2e:integration",
    "typecheck": "tsc --build",
    "typecheck:dist": "tsc --project tsconfig.dist-check.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "2.5.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@moonrepo/cli": "^2.4.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "@vitest/coverage-istanbul": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "cspell": "^10.0.1",
    "knip": "^6.17.1",
    "lefthook": "^2.1.9",
    "nyc": "^18.0.0",
    "publint": "^0.3.21",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
